{
  "manifest_version": 2,
  "name": "Hotdeal Bridge",
  "version": "3.0.0",
  "description": "Cloudflare가 서버 크롤러는 막아도 이미 통과한 브라우저 세션은 막지 않는다는 점을 이용해, 아카라이브/zod의 목록 페이지를 열어두면 감시하다가 새 글을 봇 서버 웹훅으로 전달합니다.",
  "browser_specific_settings": {
    "gecko": {
      "id": "arcalive-bridge@dev-jihoon.local",
      "strict_min_version": "78.0"
    }
  },
  "permissions": ["<all_urls>", "storage", "alarms", "tabs"],
  "background": {
    "scripts": ["config.js", "background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["https://arca.live/b/*"],
      "js": ["common.js", "content_script.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://zod.kr/deal*"],
      "js": ["common.js", "zod_site.js"],
      "run_at": "document_idle"
    }
  ]
}
